{
  "extends": ["stylelint-config-standard"],
  "plugins": ["stylelint-order"],
  "rules": {
    "order/properties-order": [
      [
        "position",
        "top",
        "right",
        "bottom",
        "left",
        "z-index",

        "display",
        "flex-direction",
        "justify-content",
        "align-items",
        "gap",

        "width",
        "height",
        "min-width",
        "min-height",
        "padding",
        "margin",

        "border",
        "border-radius",

        "background",
        "color",

        "font-size"
      ]
    ]
  }
}
